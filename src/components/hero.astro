---
import { Image } from "astro:assets";
import { getProducts } from "../lib/wix";

const products = await getProducts({});
const heroProduct = products[0];
---

<section class="relative w-full overflow-hidden bg-[#14110d] text-white">
  <div class="relative h-[80svh] min-h-[560px] w-full">
    {
      heroProduct?.featuredImage?.url ? (
        <Image
          src={heroProduct.featuredImage.url}
          alt=""
          inferSize
          width={1920}
          height={1200}
          class="absolute inset-0 h-full w-full scale-105 object-cover"
          loading="eager"
        />
      ) : null
    }
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(20,17,13,0.92)_0%,rgba(20,17,13,0.62)_38%,rgba(20,17,13,0.18)_68%),linear-gradient(0deg,rgba(20,17,13,0.9)_0%,rgba(20,17,13,0.1)_48%,rgba(20,17,13,0.45)_100%)]"
    >
    </div>
    <div
      class="relative z-10 mx-auto flex h-full w-full max-w-(--breakpoint-2xl) flex-col justify-end px-4 pb-10 md:pb-16"
    >
      <p class="eyebrow mb-4 text-[#d8b46a]">Wix Headless commerce</p>
      <h1
        class="font-display max-w-3xl text-5xl font-medium leading-[0.95] tracking-tight md:text-7xl lg:text-8xl"
      >
        Atlas Goods moves from product shelf to checkout.
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-white/78 md:text-lg">
        A storefront showcase powered by Wix catalog data, live product routes,
        cart mutations, and a checkout handoff that stays inside a fast Astro
        front end.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/search"
          class="group inline-flex items-center gap-2 rounded-full bg-[#f7f0df] px-7 py-3 text-sm font-semibold text-[#14110d] transition hover:bg-white"
        >
          Browse products
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 transition group-hover:translate-x-1"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href="/search"
          class="inline-flex items-center rounded-full border border-white/35 px-7 py-3 text-sm font-medium text-white transition hover:border-white/70 hover:bg-white/10"
        >
          View catalog
        </a>
      </div>
      <div
        class="mt-10 grid max-w-4xl gap-px overflow-hidden rounded-md border border-white/16 bg-white/12 text-sm backdrop-blur md:grid-cols-3"
      >
        <div class="bg-[#14110d]/52 p-4">
          <span class="block text-xl font-semibold text-white">01</span>
          <span class="mt-1 block text-white/68">Wix product records feed every
            product card and detail page.</span>
        </div>
        <div class="bg-[#14110d]/52 p-4">
          <span class="block text-xl font-semibold text-white">02</span>
          <span class="mt-1 block text-white/68">Variant selections and cart
            actions update through headless eCommerce APIs.</span>
        </div>
        <div class="bg-[#14110d]/52 p-4">
          <span class="block text-xl font-semibold text-white">03</span>
          <span class="mt-1 block text-white/68">Checkout stays connected to
            Wix while the storefront remains custom.</span>
        </div>
      </div>
    </div>
  </div>
</section>
