---
import { Image } from "astro:assets";
import { getProducts } from "../lib/wix";
import Price from "./price.astro";

const products = await getProducts({});
const heroProduct = products[0];
const heroPrice = heroProduct?.priceRange.maxVariantPrice;

const proofPoints = [
  {
    value: "Catalog",
    label: "Wix product data drives every shelf, tile, and product URL.",
  },
  {
    value: "Cart",
    label: "Line-item mutations stay headless while the storefront stays custom.",
  },
  {
    value: "Checkout",
    label: "The final handoff keeps payments and operations in Wix.",
  },
];
---

<section class="relative isolate w-full overflow-hidden bg-[#101112] text-white">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(200,230,220,0.24),transparent_30rem),radial-gradient(circle_at_78%_18%,rgba(184,91,69,0.22),transparent_26rem)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative h-[82svh] min-h-[620px] max-h-[880px] w-full">
    {
      heroProduct?.featuredImage?.url ? (
        <Image
          src={heroProduct.featuredImage.url}
          alt={heroProduct.featuredImage.altText || heroProduct.title}
          inferSize
          width={1920}
          height={1200}
          class="hero-image-motion absolute inset-0 h-full w-full object-cover"
          loading="eager"
        />
      ) : null
    }
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,17,18,0.96)_0%,rgba(16,17,18,0.72)_38%,rgba(16,17,18,0.22)_72%),linear-gradient(0deg,rgba(16,17,18,0.92)_0%,rgba(16,17,18,0.14)_48%,rgba(16,17,18,0.62)_100%)]"
    >
    </div>
    <div
      class="relative z-10 mx-auto grid h-full w-full max-w-(--breakpoint-2xl) content-end gap-8 px-4 pb-8 pt-24 md:pb-12 lg:grid-cols-[minmax(0,1fr)_26rem]"
    >
      <div class="reveal-up">
        <div class="mb-5 flex flex-wrap items-center gap-3">
          <p class="eyebrow text-[#c8e6dc]">Atlas Goods</p>
          <span
            class="rounded-full border border-white/18 bg-white/10 px-3 py-1 text-xs font-semibold text-white/86 backdrop-blur"
          >
            Wix Headless commerce
          </span>
        </div>
        <h1
          class="font-display max-w-4xl text-5xl font-medium leading-[0.96] md:text-7xl lg:text-8xl"
        >
          Commerce that feels collected, not templated.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-white/78 md:text-lg">
          A premium product story built on live Wix Stores catalog data,
          headless cart actions, variant-aware routes, and a checkout handoff
          that keeps the operational core intact.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/search"
            class="group inline-flex items-center gap-2 rounded-full bg-[#f7f2e7] px-7 py-3 text-sm font-bold text-[#171615] shadow-[0_18px_45px_rgba(0,0,0,0.25)] transition hover:-translate-y-0.5 hover:bg-white"
          >
            Browse products
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 transition group-hover:translate-x-1"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a
            href={heroProduct ? `/product/${heroProduct.handle}` : "/search"}
            class="inline-flex items-center rounded-full border border-white/32 bg-white/8 px-7 py-3 text-sm font-semibold text-white backdrop-blur transition hover:-translate-y-0.5 hover:border-white/70 hover:bg-white/14"
          >
            View featured item
          </a>
        </div>
      </div>

      {
        heroProduct ? (
          <a
            href={`/product/${heroProduct.handle}`}
            class="reveal-up hidden self-end rounded-[8px] border border-white/16 bg-[#101112]/64 p-4 text-white shadow-[0_24px_80px_rgba(0,0,0,0.35)] backdrop-blur-xl transition hover:-translate-y-1 hover:border-white/28 lg:block"
          >
            <span class="eyebrow text-[#c8e6dc]">Featured from Wix Stores</span>
            <span class="mt-3 block text-2xl font-semibold leading-tight">
              {heroProduct.title}
            </span>
            {heroPrice ? (
              <Price
                class="mt-3 block text-lg font-bold text-[#f7f2e7]"
                amount={heroPrice.amount}
                currencyCode={heroPrice.currencyCode}
                currencyCodeClass="ml-1 text-xs font-semibold text-white/55"
              />
            ) : null}
            <span class="mt-5 flex items-center justify-between border-t border-white/14 pt-4 text-sm text-white/70">
              <span>Product page, variants, cart</span>
              <span class="text-[#c8e6dc]">Open</span>
            </span>
          </a>
        ) : null
      }

      <div
        class="grid gap-px overflow-hidden rounded-[8px] border border-white/14 bg-white/12 text-sm backdrop-blur md:grid-cols-3 lg:col-span-2"
      >
        {
          proofPoints.map((point) => (
            <div class="bg-[#101112]/58 p-4 md:p-5">
              <span class="block text-base font-extrabold text-[#c8e6dc]">
                {point.value}
              </span>
              <span class="mt-1 block leading-6 text-white/68">
                {point.label}
              </span>
            </div>
          ))
        }
        </div>
    </div>
  </div>
</section>
