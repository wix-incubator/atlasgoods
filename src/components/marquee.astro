---
const items = [
  "Wix Stores catalog",
  "Headless cart mutations",
  "Variant-aware product pages",
  "Checkout handoff ready",
];
---

<div
  class="overflow-hidden border-y border-[#d8c7aa] bg-[#f6f1e8] py-2.5 dark:border-neutral-800 dark:bg-black"
>
  <div class="flex w-max animate-marquee">
    {
      [0, 1].map(() => (
        <div
          class="flex shrink-0 items-center gap-12 pr-12 text-[11px] font-medium uppercase tracking-[0.22em] text-[#5b4631] dark:text-neutral-300"
          aria-hidden={false}
        >
          {items.map((item) => (
            <span class="flex items-center gap-12">
              <span>{item}</span>
              <span class="opacity-30" aria-hidden="true">
                ●
              </span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
