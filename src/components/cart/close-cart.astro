---
import clsx from "clsx";
import XMarkIcon from "../icons/x-mark.astro";

type Props = { class?: string };
---

<div
  class="relative flex h-11 w-11 items-center justify-center rounded-md border border-[#d8c8ad] bg-white/64 text-[#171615] shadow-sm transition hover:border-[#4c5b48] dark:border-white/10 dark:bg-white/5 dark:text-white"
>
  <XMarkIcon
    class={clsx(
      "h-6 transition-all ease-in-out hover:scale-110",
      Astro.props.class
    )}
  />
</div>
