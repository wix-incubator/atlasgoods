---
import ShoppingCartIcon from "../icons/shopping-cart-icon.astro";
import clsx from "clsx";

type Props = {
  class?: string;
  quantity?: number | undefined;
};
---

<div
  class="relative flex h-11 w-11 items-center justify-center rounded-md border border-[#d8c8ad] bg-white/78 text-[#171615] shadow-sm transition hover:-translate-y-0.5 hover:border-[#b89b5e] hover:bg-white dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10"
>
  <ShoppingCartIcon
    class={clsx(
      "h-4 transition-all ease-in-out hover:scale-110",
      Astro.props.class
    )}
  />

  {
    Astro.props.quantity ? (
      <div class="absolute right-0 top-0 -mr-2 -mt-2 flex h-5 min-w-5 items-center justify-center rounded-full bg-[#b85b45] px-1 text-[11px] font-bold text-white shadow-sm">
        {Astro.props.quantity}
      </div>
    ) : null
  }
</div>
