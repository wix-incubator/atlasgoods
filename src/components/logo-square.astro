---
type Props = { size?: "sm" | undefined };
import clsx from "clsx";
import LogoIcon from "./icons/logo.astro";
---

<div
  class={clsx(
    "flex flex-none items-center justify-center border border-[#d8c8ad] bg-white shadow-sm dark:border-white/10 dark:bg-white/5",
    {
      "h-[40px] w-[40px] rounded-[8px]": !Astro.props.size,
      "h-[30px] w-[30px] rounded-[8px]": Astro.props.size === "sm",
    }
  )}
>
  <LogoIcon
    class={clsx({
      "h-[16px] w-[16px]": !Astro.props.size,
      "h-[10px] w-[10px]": Astro.props.size === "sm",
    })}
  />
</div>
