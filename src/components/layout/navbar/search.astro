---

---

<form action="/search" class="w-max-[550px] relative w-full lg:w-80 xl:w-full">
  <input
    type="text"
    name="q"
    placeholder="Search the live catalog"
    autocomplete="off"
    value={Astro.url.searchParams?.get("q") || ""}
    class="text-md h-10 w-full rounded-full border border-[#d8c8ad] bg-white/78 px-4 pr-10 text-black shadow-sm outline-none transition placeholder:text-[#8a8173] hover:border-[#b89b5e] focus:border-[#4c5b48] md:text-sm dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-[#b7aea0]"
  />
  <div class="absolute right-0 top-0 mr-3 flex h-full items-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6 h-4 text-[#4c5b48] dark:text-[#d8d2c5]"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
      ></path>
    </svg>
  </div>
</form>
