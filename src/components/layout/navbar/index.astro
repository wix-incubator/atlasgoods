---
import { getCollections } from "../../../lib/wix";
import type { Menu } from "../../../lib/wix/types";
import CartModal from "../../cart/cart-modal.astro";
import LogoSquare from "../../logo-square.astro";
import MobileMenu from "./mobile-menu.astro";
import Search from "./search.astro";

// Drive navbar links from real store categories (each Collection has `path` and `title`).
const collections = await getCollections();
const menu: Menu[] = collections.map((c) => ({ title: c.title, path: c.path }));

const { SITE_NAME } = import.meta.env;
---

<nav
  class="sticky top-0 z-40 border-b border-[#e0d3bf]/80 bg-[#fbfaf6]/88 text-[#171615] backdrop-blur-xl dark:border-white/10 dark:bg-[#101112]/86 dark:text-[#f8f5ed]"
>
  <div class="mx-auto flex w-full max-w-(--breakpoint-2xl) items-center justify-between px-4 py-3 lg:px-6">
    <div class="block flex-none md:hidden">
      <MobileMenu menu={menu}>
        <Search />
      </MobileMenu>
    </div>
    <div class="flex w-full items-center">
      <div class="flex w-full items-center md:w-1/3">
        <a
          href="/"
          class="mr-3 flex w-full items-center justify-center md:w-auto lg:mr-6"
        >
          <LogoSquare />
          <div
            class="ml-2 flex-none text-sm font-extrabold uppercase md:hidden lg:block"
          >
            {SITE_NAME}
          </div>
        </a>
        <span
          class="mr-5 hidden rounded-full border border-[#d9c7a9] bg-white/70 px-3 py-1 text-[11px] font-bold uppercase text-[#4c5b48] shadow-sm lg:inline-flex dark:border-white/10 dark:bg-white/5 dark:text-[#d8d2c5]"
        >
          Wix Headless
        </span>
      {
        menu.length ? (
          <ul class="hidden gap-1 text-sm md:flex md:items-center">
            {menu.map((item: Menu) => (
              <li>
                <a
                  href={item.path}
                  data-astro-prefetch
                  class="rounded-full px-3 py-2 font-medium text-[#61594e] transition hover:bg-[#efe7d9] hover:text-[#171615] dark:text-[#d8d2c5] dark:hover:bg-white/10 dark:hover:text-white"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
    </div>
      <div class="hidden justify-center md:flex md:w-1/3">
        <Search />
      </div>

      <div class="flex justify-end md:w-1/3">
        <CartModal />
      </div>
    </div>
  </div>
</nav>
