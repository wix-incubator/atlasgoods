---
import { getMenu } from "../../lib/wix";
import LogoSquare from "../logo-square.astro";
import FooterMenu from "./footer-menu.astro";

const { COMPANY_NAME, SITE_NAME } = import.meta.env;
const currentYear = new Date().getFullYear();
const copyrightName = COMPANY_NAME || SITE_NAME || "";
const copyrightSuffix =
  copyrightName.length && !copyrightName.endsWith(".") ? "." : "";
const menu = await getMenu("next-js-frontend-footer-menu");
---

<footer class="bg-[#111211] text-sm text-[#d8d2c5]">
  <div
    class="mx-auto flex w-full max-w-(--breakpoint-2xl) flex-col gap-8 border-t border-white/10 px-4 py-12 text-sm md:flex-row md:items-start md:justify-between md:gap-12"
  >
    <div class="max-w-sm">
      <a
        class="flex items-center gap-2 text-white md:pt-1"
        href="/"
      >
        <LogoSquare size="sm" />
        <span class="font-extrabold uppercase">{SITE_NAME}</span>
      </a>
      <p class="mt-4 leading-6 text-[#aaa396]">
        Powered by Wix Headless commerce with live catalog routes, custom
        cart behavior, and checkout powered by Wix.
      </p>
    </div>
    <FooterMenu menu={menu} />
  </div>
  <div class="border-t border-white/10 py-6 text-sm">
    <div
      class="mx-auto flex w-full max-w-(--breakpoint-2xl) flex-col gap-2 px-4 text-center md:flex-row md:items-center md:justify-between md:text-left"
    >
      <p>
        &copy; {currentYear}
        {copyrightName}{copyrightSuffix} All rights reserved.
      </p>
      <div class="flex flex-col gap-2 font-semibold text-[#c8e6dc] md:items-end">
        <p>
          Powered by Wix Headless | Built with
          <a class="underline underline-offset-4 hover:text-white" href="https://www.wix-headless.dev" target="_blank" rel="noreferrer">wix-headless.dev</a>
        </p>
        <a class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/20 text-[#c8e6dc] transition-colors hover:border-white hover:text-white" href="https://github.com/wix-incubator/atlasgoods" target="_blank" rel="noreferrer" aria-label="View source on GitHub" title="View source on GitHub">
          <svg class="h-4 w-4 fill-current" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.79 8.21 11.38.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.39 1.24-3.23-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.63-5.49 5.93.43.37.81 1.1.81 2.22 0 1.61-.02 2.9-.02 3.3 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
