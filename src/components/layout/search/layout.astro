---
import { sorting } from "../../../lib/constants";
import Footer from "../footer.astro";
import Collections from "./collections.astro";
import FilterList from "./filter/filter-list.astro";
---

<div
  class="mx-auto flex max-w-(--breakpoint-2xl) flex-col gap-8 px-4 pb-16 pt-8 text-[#171615] md:flex-row md:gap-12 md:pt-12 dark:text-[#f8f5ed]"
>
  <aside
    class="order-first w-full flex-none md:sticky md:top-28 md:max-w-[190px] md:self-start"
  >
    <Collections />
  </aside>
  <div class="order-last min-h-screen w-full md:order-none">
    <slot />
  </div>
  <aside
    class="order-none flex-none md:sticky md:top-28 md:order-last md:w-[170px] md:self-start"
  >
    <FilterList list={sorting} title="Sort by" />
  </aside>
</div>
<Footer />
