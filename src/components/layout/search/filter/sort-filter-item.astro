---
import clsx from "clsx";
import type { SortFilterItem } from "../../../../lib/constants";
import { createUrl } from "../../../../lib/utils";

type Props = { item: SortFilterItem };

const searchParams = new URLSearchParams(Astro.url.search);
const active = searchParams.get("sort") === Astro.props.item.slug;
const q = searchParams.get("q");
const href = createUrl(
  Astro.url.pathname,
  new URLSearchParams({
    ...(q && { q }),
    ...(Astro.props.item.slug &&
      Astro.props.item.slug.length && { sort: Astro.props.item.slug }),
  })
);
const DynamicTag = active ? "p" : "a";
---

<li>
  <DynamicTag
    data-astro-prefetch={!active ? false : undefined}
    href={href}
    class={clsx(
      "group relative flex items-center gap-2 rounded-full px-2 py-1.5 text-sm transition-colors",
      active
        ? "bg-[#e5efe0] font-bold text-[#171615] dark:bg-white/10 dark:text-white"
        : "text-[#655d51] hover:bg-[#f1ebdf] hover:text-[#171615] dark:text-[#d8d2c5] dark:hover:bg-white/8 dark:hover:text-white",
    )}
  >
    <span
      class={clsx(
        "h-1 w-1 flex-none rounded-full transition-all",
        active
          ? "bg-[#4c5b48] dark:bg-[#c8e6dc]"
          : "bg-transparent group-hover:bg-[#b89b5e] dark:group-hover:bg-[#c8e6dc]",
      )}
      aria-hidden="true"></span>
    <span>{Astro.props.item.title}</span>
  </DynamicTag>
</li>
