---
import clsx from "clsx";
import type { PathFilterItem } from ".";
import { createUrl } from "../../../../lib/utils";

type Props = { item: PathFilterItem };

const active = Astro.url.pathname === Astro.props.item.path;
const newParams = new URLSearchParams(Astro.url.search);
const DynamicTag = active ? "p" : "a";

newParams.delete("q");
---

<li>
  <DynamicTag
    href={createUrl(Astro.props.item.path, newParams)}
    class={clsx(
      "group relative flex items-center gap-2 rounded-full px-2 py-1.5 text-sm capitalize transition-colors",
      active
        ? "bg-[#e5efe0] font-bold text-[#171615] dark:bg-white/10 dark:text-white"
        : "text-[#655d51] hover:bg-[#f1ebdf] hover:text-[#171615] dark:text-[#d8d2c5] dark:hover:bg-white/8 dark:hover:text-white",
    )}
  >
    <span
      class={clsx(
        "h-1 w-1 flex-none rounded-full transition-all",
        active
          ? "bg-[#4c5b48] dark:bg-[#c8e6dc]"
          : "bg-transparent group-hover:bg-[#b89b5e] dark:group-hover:bg-[#c8e6dc]",
      )}
      aria-hidden="true"></span>
    <span>{Astro.props.item.title}</span>
  </DynamicTag>
</li>
