---
import type { Menu } from "../../lib/wix/types";
import clsx from "clsx";

type Props = {
  menu: Menu[];
};

if (!Astro.props.menu.length) return null;
---

<nav>
  <ul class="flex flex-col gap-1 md:items-end">
    {
      Astro.props.menu.map((item) => (
        <Fragment>
          <li>
            <a
              href={item.path === "//" ? "/" : item.path}
              class={clsx(
                "block rounded-full px-3 py-2 text-lg font-semibold text-[#aaa396] transition hover:bg-white/8 hover:text-white md:inline-block md:text-sm",
                {
                  "bg-white/8 text-white":
                    Astro.url.pathname === item.path,
                }
              )}
            >
              {item.title}
            </a>
          </li>
        </Fragment>
      ))
    }
  </ul>
</nav>
