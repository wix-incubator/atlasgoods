---
import { Image } from "astro:assets";
import clsx from "clsx";
import Label from "../label.astro";
import type { ComponentProps } from "astro/types";

type Props = {
  isInteractive?: boolean;
  active?: boolean;
  label?: {
    title: string;
    amount: string;
    currencyCode: string;
    position?: "bottom" | "center";
  };
} & ComponentProps<typeof Image>;
---

<div
  class={clsx(
    "group relative flex h-full w-full items-center justify-center overflow-hidden rounded-[8px] border border-[#ded2bf] bg-[#ede8df] shadow-[0_14px_34px_rgba(23,22,21,0.08)] transition duration-500 dark:border-white/10 dark:bg-[#191817] dark:shadow-none",
    {
      "ring-2 ring-[#4c5b48] ring-offset-2 ring-offset-[#fbfaf6] dark:ring-[#c8e6dc] dark:ring-offset-[#101112]":
        Astro.props.active,
    }
  )}
>
  {
    Astro.props.src ? (
      <Image
        class={clsx("relative h-full w-full object-cover", {
          "transition-transform duration-700 ease-out group-hover:scale-[1.045]":
            Astro.props.isInteractive ?? true,
        })}
        {...Astro.props}
      />
    ) : null
  }
  {
    Astro.props.label ? (
      <Label
        title={Astro.props.label.title}
        amount={Astro.props.label.amount}
        currencyCode={Astro.props.label.currencyCode}
        position={Astro.props.label.position}
      />
    ) : null
  }
</div>
